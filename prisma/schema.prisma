// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// ..Comensales: Horarios Dinamicos

model MealSchedule {
  id        Int      @id @default(autoincrement())
  //guardara valores como "DESAYUNO", "ALMUERZO", "CENA", "SOBRECENA"
  //Es @unique porque no sepueden haber dos horarios de almuerzo dintintos.
  shiftType String   @unique @map("shift_type")
  //Guardamos la hora en fornato militar estricto
  startTime String   @map("start_time") // Ej: "07:00"
  endTime   String   @map("end_time") // Ej: "09:00"  
  //Boton de apagado de emergencia si se suspende el turno
  active    Boolean  @default(true)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("meal_schedules")
}

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ── CONFIGURACIONES GLOBALES ─────────────────────────────────────────────────
model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique // Ej: "REQUEST_CUTOFF_TIME", "REQUEST_MIN_DAYS_AHEAD"
  value     String   @db.Text
  description String?
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ── ROLES Y PERMISOS DINÁMICOS ──────────────────────────────────────────────

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique // Ej: "Administrador", "Almacenista"
  description String?
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Module {
  id          Int              @id @default(autoincrement())
  name        String // Ej: "Productos", "Almacenes"
  code        String           @unique // Ej: "PRODUCTS", "WAREHOUSES"
  permissions RolePermission[]

  @@map("modules")
}

model RolePermission {
  id       Int    @id @default(autoincrement())
  roleId   Int    @map("role_id")
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleId Int    @map("module_id")
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  // Banderas CRUD granulares (Matriz)
  canCreate Boolean @default(false) @map("can_create")
  canRead   Boolean @default(false) @map("can_read")
  canUpdate Boolean @default(false) @map("can_update")
  canDelete Boolean @default(false) @map("can_delete")

  // Un rol solo puede tener una configuración por cada módulo
  @@unique([roleId, moduleId])
  @@map("role_permissions")
}

// ── USUARIOS ───────────────────────────────────────────────────────────────

model User {
  id           Int     @id @default(autoincrement())
  cedula       String  @unique
  name         String
  passwordHash String  @map("password_hash")
  active       Boolean @default(true)

  // Relación obligatoria: Todo usuario debe tener un Rol
  roleId Int  @map("role_id")
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // Control de Sesión Única e Inactividad
  activeSessionId String?   @map("active_session_id")
  lastActiveAt    DateTime? @map("last_active_at")

  // Aislamiento por Sede (Soporte Multi-Sede M:N)
  sites Site[] @relation("UserSites")

  // Aislamiento por Dependencia (Para Gerentes, Autoridad sobre todas las subdependencias)
  dependencyId Int?        @map("dependency_id")
  dependency   Dependency? @relation(fields: [dependencyId], references: [id], onDelete: Restrict)

  // Aislamiento por Subdependencia (Para Solicitantes/Aprobadores de Comensales)
  subdependencyId Int?           @map("subdependency_id")
  subdependency   Subdependency? @relation(fields: [subdependencyId], references: [id], onDelete: Restrict)

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  auditLogs AuditLog[]

  // Relaciones inversas (Notificaciones)
  notifications        Notification[]

  createdDinerRequests  DinerRequest[] @relation("DinerRequestsCreated")
  approvedDinerRequests DinerRequest[] @relation("DinerRequestsApproved")
  extraordinaryDispatches ExtraordinaryDispatch[]
  approvedExtraordinaryDispatches ExtraordinaryDispatch[] @relation("ExtraordinaryApprover")

  @@index([roleId])
  @@index([dependencyId])
  @@index([subdependencyId])
  @@map("users")
}

// ---- Audotorial de cambios (opcional) ----
model AuditLog {
  id        Int      @id @default(autoincrement())
  //Quien hizo la Accion (Opcional, porque algunas Acciones Automaticas del sistema no tienen USuarios)
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // Ej: "Login", "Crear Producto", "Eliminar Almacen"
  entity    String // Ej: "Producto", "Almacen"
  entityId  Int?     @map("entity_id")
  // ID del Producto o Almacen afectado (opcional)
  details   String?  @db.Text // Detalles adicionales (JSON stringificado, por ejemplo)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}



// ── SISTEMA DE NOTIFICACIONES PUSH ─────────────────────────────────────────

model Notification {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id") // A quién va dirigida
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  isRead  Boolean @default(false) @map("is_read")

  // Para saber a qué pantalla redirigir cuando hacen clic en la campana
  link String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

// ── MÓDULO COMENSALES (ESTRUCTURA ORGANIZACIONAL) ─────────────────────────

model Site {
  id          Int     @id @default(autoincrement())
  name        String  @unique // Ej: "PLC", "MSB"
  description String?
  active      Boolean @default(true)

  diningRooms DiningRoom[]
  diners      Diner[]
  users       User[]       @relation("UserSites")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sites")
}

model DiningRoom {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  siteId Int   @map("site_id")
  site   Site  @relation(fields: [siteId], references: [id], onDelete: Restrict)


  dinerRequests DinerRequest[]
  extraordinaryDispatches ExtraordinaryDispatch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")


  @@map("dining_rooms")
}

model Dependency {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  active          Boolean         @default(true)
  subdependencies Subdependency[]
  users           User[]
  extraordinaryDispatches ExtraordinaryDispatch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("dependencies")
}

model Subdependency {
  id           Int        @id @default(autoincrement())
  name         String
  active             Boolean    @default(true)
  allowsBulkRequests Boolean    @default(false) @map("allows_bulk_requests")
  dependencyId       Int        @map("dependency_id")
  dependency         Dependency @relation(fields: [dependencyId], references: [id], onDelete: Restrict)

  users  User[]
  diners Diner[]
  targetRequests DinerRequest[]
  extraordinaryDispatches ExtraordinaryDispatch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([dependencyId, name])
  @@index([dependencyId])
  @@map("subdependencies")
}

model Squad {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  diners Diner[]


  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("squads")
}

model Position {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  diners Diner[]


  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("positions")
}

model Diner {
  id         Int     @id @default(autoincrement())
  cedula     String  @unique
  name       String
  rationType String  @default("NORMAL") @map("ration_type") // NORMAL o DIETA
  active     Boolean @default(true)

  // A qué subdependencia/área pertenece el trabajador
  subdependencyId Int           @map("subdependency_id")
  subdependency   Subdependency @relation(fields: [subdependencyId], references: [id], onDelete: Restrict)

  // A qué cuadrilla/turno (catálogo base) está asignado
  squadId Int   @map("squad_id")
  squad   Squad @relation(fields: [squadId], references: [id], onDelete: Restrict)

  // Cargo o puesto del trabajador (opcional por retrocompatibilidad)
  positionId Int?      @map("position_id")
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  // Sede Base asignada al trabajador
  siteId Int?        @map("site_id")
  site   Site?       @relation(fields: [siteId], references: [id], onDelete: SetNull)

  fingerprint String? @db.Text // TODO: Eliminar en futura migración cuando todos usen BiometricRecord
  qrCode      String? @unique @map("qr_code")

  requestDetails  DinerRequestDetail[]
  biometricRecord BiometricRecord?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([subdependencyId])
  @@index([squadId])
  @@index([positionId])
  @@index([siteId])
  @@map("diners")
}

model DinerRequest {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  shiftType String   @map("shift_type") // DESAYUNO, ALMUERZO, CENA, SOBRECENA
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  // Código único para identificar un bloque de solicitudes enviadas simultáneamente
  batchCode String?  @map("batch_code")

  createdById Int  @map("created_by_id")
  createdBy   User @relation(name: "DinerRequestsCreated", fields: [createdById], references: [id], onDelete: Restrict)

  approvedById Int?  @map("approved_by_id")
  approvedBy   User? @relation(name: "DinerRequestsApproved", fields: [approvedById], references: [id], onDelete: SetNull)

  diningRoomId Int?        @map("dining_room_id")
  diningRoom   DiningRoom? @relation(fields: [diningRoomId], references: [id], onDelete: SetNull)

  targetSubdependencyId Int?           @map("target_subdependency_id")
  targetSubdependency   Subdependency? @relation(fields: [targetSubdependencyId], references: [id], onDelete: SetNull)

  details DinerRequestDetail[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([createdById])
  @@index([approvedById])
  @@index([diningRoomId])
  @@index([date])
  @@map("diner_requests")
}

model DinerRequestDetail {
  id        Int          @id @default(autoincrement())
  requestId Int          @map("request_id")
  request   DinerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // Define si el plato se consume en bandeja (DINE_IN) o en envase para llevar (TAKE_AWAY)
  modality String @default("DINE_IN")

  dinerId Int   @map("diner_id")
  diner   Diner @relation(fields: [dinerId], references: [id])

  rationType String @default("NORMAL") @map("ration_type")
  quantity   Int    @default(1)

  dispatchedAt DateTime? @map("dispatched_at")
  dispatchedById Int?      @map("dispatched_by_id")
  isEmergency    Boolean   @default(false) @map("is_emergency")
  receiverCedula String?   @map("receiver_cedula")

  @@unique([requestId, dinerId])
  @@index([requestId])
  @@index([dinerId])
  @@map("diner_request_details")
}

model BiometricRecord {
  id      Int   @id @default(autoincrement())
  dinerId Int   @unique @map("diner_id")
  diner   Diner @relation(fields: [dinerId], references: [id], onDelete: Cascade)

  templates String[] // Arreglo de strings con los FMD Base64 ultraligeros
  active    Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([dinerId])
  @@map("biometric_records")
}

model ExtraordinaryDispatch {
  id             Int        @id @default(autoincrement())
  date           DateTime   @db.Date
  shiftType      String     @map("shift_type") // DESAYUNO, ALMUERZO, CENA, SOBRECENA
  
  diningRoomId   Int        @map("dining_room_id")
  diningRoom     DiningRoom @relation(fields: [diningRoomId], references: [id])
  
  companyName    String     @map("company_name")
  personId       String     @map("person_id")
  quantity       Int        @default(1)
  
  dependencyId   Int?       @map("dependency_id")
  dependency     Dependency? @relation(fields: [dependencyId], references: [id])
  
  subdependencyId Int?       @map("subdependency_id")
  subdependency   Subdependency? @relation(fields: [subdependencyId], references: [id])
  
  observation    String?    @db.Text
  modality       String     @default("DINE_IN")
  
  status         String     @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById   Int?       @map("approved_by_id")
  approver       User?      @relation("ExtraordinaryApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?  @map("approved_at")
  deletedAt      DateTime?  @map("deleted_at")
  
  dispatchedAt   DateTime   @default(now()) @map("dispatched_at")
  dispatchedById Int        @map("dispatched_by_id")
  dispatcher     User       @relation(fields: [dispatchedById], references: [id])
  
  @@map("extraordinary_dispatches")
}
